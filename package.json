{
  "name": "termless",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS app that lets people who don't use the command line get terminal things done — in plain language.",
  "license": "MIT",
  "author": "KhalilHsu",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "npm run build && electron-builder --mac --dir && scripts/sign-mac.sh",
    "install:mac": "scripts/install-mac.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "Termless",
  "build": {
    "appId": "io.github.khalilhsu.termless",
    "productName": "Termless",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.utilities",
      "identity": null
    }
  }
}
